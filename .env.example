APP_ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
DATABASE_URL=postgresql+asyncpg://hu_lab_app:replace-with-local-password@127.0.0.1:5432/hu_lab_management
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQL_ECHO=false

# Leave empty until stakeholders designate authorized existing application roles.
# Any configured role may make one decision; this does not add a role or configure multiple approvals.
MAINTENANCE_APPROVER_ROLES=

# Optional QR destination origin; leave unset until the public frontend host is confirmed.
# ASSET_PUBLIC_BASE_URL=

POSTGRES_DB=hu_lab_management
POSTGRES_USER=hu_lab_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
